<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- activate the following options in the global settings: * Allow a different address for delivery and invoicing -->
    <!-- Note: product.group_discount_per_so_line was removed in Odoo 18.0 - discounts are now always available -->
    <record model="res.groups" id="base.group_user">
        <field
            name="implied_ids"
            eval="[(4, ref('account.group_delivery_invoice_address'))]"
        />
    </record>
    <!-- the connector managers always need theses rights to import or export products, sales orders, ... -->
    <record id="connector.group_connector_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]" />
    </record>
</odoo>
